import random

print("Welcome player")

total_rounds = 0
rounds_won = 0
total_score = 0

play_again = "y"

while play_again.lower() == "y":
    total_rounds += 1
    secret_number = random.randint(1, 100)
    print("\nI'm thinking of a number between 1 and 100.")
    print("You have 6 attempts to guess it.")

    won = False
    for attempt in range(1, 7):
        print(f"\nAttempt {attempt}/6")
        guess = int(input("Enter your guess: "))

        if guess == secret_number:
            print("Congratulations!")
            print("You guessed the number")
            
            guesses_remaining = 6 - attempt
            multiplier = guesses_remaining + 1
            points = multiplier
            
            total_score += points
            rounds_won += 1
            won = True

            print(f"Guesses remaining: {guesses_remaining}")
            print(f"Multiplier: x{multiplier}")
            print(f"Points earned: {points}")
            print(f"Current Score: {total_score}")
            break
        else:
            diff = abs(secret_number - guess)
            if diff > 15:
                if guess < secret_number:
                    print("Too low")
                else:
                    print("Too high")
            else:
                if guess < secret_number:
                    print("Higher")
                else:
                    print("Lower")

    if not won:
        print(f"\nYou ran out of attempts! The number was {secret_number}.")

    play_again = input("\nPlay another round? (y/n): ")

print(f"\nRounds Played: {total_rounds}")
print(f"Rounds Won: {rounds_won}")
print(f"Final Score: {total_score}")
